+# Port & Speed Selection
+# ----------------------
+RHPORT_DEVICE ?= 1
+RHPORT_HOST ?= 1
+
+ifndef RHPORT_DEVICE_SPEED
+  RHPORT_DEVICE_SPEED = OPT_MODE_HIGH_SPEED
