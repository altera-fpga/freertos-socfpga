+static inline void SPC_EnableSystemLDORegulator(SPC_Type *base, bool enable)
+{
+    if (enable)
+    {
+        base->CNTRL |= SPC_CNTRL_SYSLDO_EN_MASK;
+    }
+    else
+    {
+        /*
+         * $Branch Coverage Justification$
+         * If SYSTEM_LDO is disabled, may cause some unexpected issues.
