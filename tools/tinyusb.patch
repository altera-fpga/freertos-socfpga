-def option_maker(options, key, val)
-  options ||= {}
-  options[key.to_sym] =
-    if val.chr == ':'
-      val[1..-1].to_sym
-    elsif val.include? ';'
-      val.split(';')
-    elsif val == 'true'
-      true
-    elsif val == 'false'
-      false
-    elsif val =~ /^\d+$/
-      val.to_i
-    else
-      val
-    end
