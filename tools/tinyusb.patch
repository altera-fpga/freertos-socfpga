-    stream.puts "\t\t<Ignores>#{counts[:ignored]}</Ignores>"
-    stream.puts "\t\t<FailuresTotal>#{counts[:failed]}</FailuresTotal>"
-    stream.puts "\t\t<Errors>0</Errors>"
