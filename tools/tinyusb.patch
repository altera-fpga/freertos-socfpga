+void SPC_SetDCDCRefreshCount(SPC_Type *base, uint16_t count)
+{
+    uint32_t reg;
+
+    reg = base->DCDC_BURST_CFG;
+    reg &= ~SPC_DCDC_BURST_CFG_PULSE_REFRESH_CNT_MASK;
+    reg |= SPC_DCDC_BURST_CFG_PULSE_REFRESH_CNT(count);
+
+    base->DCDC_BURST_CFG = reg;
+}
