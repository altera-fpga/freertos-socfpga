[submodule "FreeRTOS/Source"]
	path = FreeRTOS/Source
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "FreeRTOS/FreeRTOS-Plus/Source/FreeRTOS-Plus-TCP"]
	path = FreeRTOS/FreeRTOS-Plus/Source/FreeRTOS-Plus-TCP
	url = https://github.com/FreeRTOS/FreeRTOS-Plus-TCP.git
[submodule "tools/ATF"]
	path = tools/ATF
	url = https://github.com/altera-fpga/arm-trusted-firmware.git
	branch = socfpga_v2.14.0
[submodule "tinyusb"]
	path = tinyusb
	url = https://github.com/Ignitarium-Technology/tinyusb.git
[submodule "fcs/libfcs"]
	path = fcs/libfcs
	url = https://github.com/altera-innersource/libraries.fpga.libfcs-dev.git
[submodule "rsu/librsu"]
	path = rsu/librsu
	url = https://github.com/altera-innersource/libraries.fpga.unified-librsu-dev.git
[submodule "FreeRTOS/Fat-Fs"]
	path = FreeRTOS/Fat-Fs
	url = https://github.com/FreeRTOS/Lab-Project-FreeRTOS-FAT.git
